{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "simple": {
      "format": "(%(levelname)s) %(asctime)s - %(name)s: %(message)s",
      "datefmt": "%d-%m-%Y %H:%M:%S"
    },
    "extra": {
      "format": "%(asctime)-16s %(name)-8s %(filename)-12s %(lineno)-6s %(funcName)-30s %(levelname)-8s %(message)s",
      "datefmt": "%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "simple",
      "stream": "ext://sys.stdout"
    },
    "debug_file_handler": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "simple",
      "filename": "./logs/debug.log",
      "maxBytes": 5242880,
      "backupCount": 3,
      "encoding": "utf8",
      "filters": [
        "debug_filter"
      ]
    },
    "info_file_handler": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "INFO",
      "formatter": "simple",
      "filename": "./logs/info.log",
      "maxBytes": 5242880,
      "backupCount": 3,
      "encoding": "utf8",
      "filters": [
        "info_filter"
      ]
    },
    "warning_file_handler": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "WARNING",
      "formatter": "simple",
      "filename": "./logs/warning.log",
      "maxBytes": 5242880,
      "backupCount": 3,
      "encoding": "utf8",
      "filters": [
        "warning_filter"
      ]
    },
    "error_file_handler": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "ERROR",
      "formatter": "simple",
      "filename": "./logs/error.log",
      "maxBytes": 5242880,
      "backupCount": 1,
      "encoding": "utf8",
      "filters": [
        "error_filter"
      ]
    }
  },
  "filters": {
    "debug_filter": {
      "()": "utils.config.LevelFilter",
      "level": 10
    },
    "info_filter": {
      "()": "utils.config.LevelFilter",
      "level": 20
    },
    "warning_filter": {
      "()": "utils.config.LevelFilter",
      "level": 30
    },
    "error_filter": {
      "()": "utils.config.LevelFilter",
      "level": 40
    }
  },
  "root": {
    "level": "DEBUG",
    "handlers": [
      "console",
      "debug_file_handler",
      "info_file_handler",
      "warning_file_handler",
      "error_file_handler"
    ]
  }
}